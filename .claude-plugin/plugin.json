{
  "name": "ccbeep",
  "description": "Sound notifications for Claude Code — plays a chime when tasks complete and a warning when they fail, so you don't have to watch the terminal.",
  "version": "1.0.0",
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/ccbeep.sh complete",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/ccbeep.sh stop",
            "async": true
          }
        ]
      }
    ]
  }
}
