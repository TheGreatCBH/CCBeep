{
  "_description": "CCBeep hook configuration reference. Use install.sh for automatic setup, or install as a Claude Code plugin. Replace <CCBEEP_DIR> with the absolute path to this project.",

  "hooks": {

    "_comment_PermissionRequest": "Fires when a permission dialog is about to appear — plays a prompt sound.",
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "<CCBEEP_DIR>/ccbeep.sh prompt"
          }
        ]
      }
    ],

    "_comment_Stop": "Fires when agent stops — plays notification sound.",
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "<CCBEEP_DIR>/ccbeep.sh stop",
            "async": true
          }
        ]
      }
    ]
  },

  "_windows_example": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File \"<CCBEEP_DIR>\\ccbeep.ps1\" -Event complete",
            "shell": "powershell",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File \"<CCBEEP_DIR>\\ccbeep.ps1\" -Event stop",
            "shell": "powershell",
            "async": true
          }
        ]
      }
    ]
  },

  "_sound_customization": {
    "macOS_available_sounds": ["Basso", "Blow", "Bottle", "Frog", "Funk", "Glass", "Hero", "Morse", "Ping", "Pop", "Purr", "Sosumi", "Submarine", "Tink"],
    "how_to_customize": "Create ~/.ccbeep.json with {\"sound\": \"Sosumi\"}, or run ./configure.sh"
  }
}
