{
  "_description": "CCBee hook configuration reference. Use install.sh for automatic setup, or copy the 'hooks' block into ~/.claude/settings.json manually. Replace <CCBEEP_DIR> with the absolute path to this project.",

  "hooks": {

    "_comment_Notification": "Fires on desktop notification events — plays a completion chime.",
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "<CCBEEP_DIR>/ccbee.sh complete"
          }
        ]
      }
    ],

    "_comment_Stop": "Fires when agent stops — script reads stdin JSON to auto-detect error vs success.",
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "<CCBEEP_DIR>/ccbee.sh stop"
          }
        ]
      }
    ]
  },

  "_windows_example": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File \"<CCBEEP_DIR>\\ccbee.ps1\" -Event complete",
            "shell": "powershell"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File \"<CCBEEP_DIR>\\ccbee.ps1\" -Event stop",
            "shell": "powershell"
          }
        ]
      }
    ]
  },

  "_sound_customization": {
    "macOS_available_sounds": ["Basso", "Blow", "Bottle", "Frog", "Funk", "Glass", "Hero", "Morse", "Ping", "Pop", "Purr", "Sosumi", "Submarine", "Tink"],
    "how_to_customize": "Edit the sound names in ccbee.sh — no config file needed."
  }
}
